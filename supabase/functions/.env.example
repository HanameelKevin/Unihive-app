# Copy to .env.local for local function testing. Keep all real values in
# Supabase Edge Function Secrets in deployed environments.
# Payment initiation remains disabled until credentials and merchant approval
# have been verified.
MPESA_ENABLED=false
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORTCODE=
MPESA_TRANSACTION_TYPE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/mpesa-callback
